# ==========================================
# CONFIGURACIÓN DEL SISTEMA DE AUDITORÍA (18 HABITACIONES)
# ==========================================

# Entorno y Puerto de Express
NODE_ENV=production
PORT=10000

# Base de Datos PostgreSQL (Neon / Supabase / Render Postgres)
DATABASE_URL=postgresql://usuario:password@ep-ejemplo.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://usuario:password@ep-ejemplo.us-east-2.aws.neon.tech/neondb?sslmode=require

# Tuya Cloud Platform - Apache Pulsar
TUYA_ACCESS_ID=tuya_client_id_aqui
TUYA_ACCESS_SECRET=tuya_client_secret_aqui
TUYA_ENV=prod
# Regiones Tuya: cn, us, us-e, eu
TUYA_REGION=us

# Bot de Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_ADMIN_CHAT_ID=-1001234567890
